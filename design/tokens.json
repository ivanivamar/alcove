{
  "$description": "Alcove design tokens v1.0. Same values as tokens.css; use this one for tooling (Style Dictionary, Figma import, tests).",
  "color": {
    "dark": {
      "wall": "#171310", "rail": "#1C1713", "paper": "#211B16", "raised": "#2A231C", "segOn": "#342B23", "bay": "#15110E",
      "ink": "#EAE0D0", "inkMuted": "#A39784", "hairline": "#342B23", "hairlineStrong": "#4A3D31",
      "accent": "#8FBFA9", "onAccent": "#171310", "lamp": "#D9A066", "danger": "#E08A7A",
      "wood": "#6B4A34", "woodTop": "#80593F", "woodUnder": "#533826", "bookend": "#4A4540"
    },
    "light": {
      "wall": "#F6F2EA", "rail": "#FBF8F2", "paper": "#FBF8F2", "raised": "#FFFDF9", "segOn": "#EDE6D9", "bay": "#EFE8DC",
      "ink": "#2A2622", "inkMuted": "#6E665C", "hairline": "#E2DACB", "hairlineStrong": "#CDBFA8",
      "accent": "#3E6B5A", "onAccent": "#FBF8F2", "lamp": "#A64B30", "danger": "#A33A2A",
      "wood": "#C9A878", "woodTop": "#DABF94", "woodUnder": "#B08F60", "bookend": "#9A948B"
    }
  },
  "paper": {
    "paper": { "page": "#FBF8F2", "ink": "#2A2622", "muted": "#6E665C", "edge": "#E9E2D4", "edgeDark": "#CFC5B3", "accent": "#A64B30", "contrast": 14.2 },
    "sepia": { "page": "#F1E4CC", "ink": "#3B3024", "muted": "#6B5A45", "edge": "#E3D2B2", "edgeDark": "#C7B38E", "accent": "#A64B30", "contrast": 10.2 },
    "slate": { "page": "#2B2F33", "ink": "#DCDAD3", "muted": "#A3A5A1", "edge": "#3A3F44", "edgeDark": "#24272A", "accent": "#D9A066", "contrast": 9.6, "default": true },
    "night": { "page": "#1A1816", "ink": "#B9B2A6", "muted": "#8C8579", "edge": "#2A2724", "edgeDark": "#121110", "accent": "#B98A58", "contrast": 8.4 }
  },
  "font": {
    "display": "Fraunces", "ui": "DM Sans", "read": "Literata",
    "readOptions": ["Literata", "Source Serif 4", "Atkinson Hyperlegible", "DM Sans"]
  },
  "type": {
    "displayXL": { "family": "display", "weight": 400, "size": 64, "lineHeight": 64, "tracking": "-0.01em" },
    "displayL": { "family": "display", "weight": 400, "size": 40, "lineHeight": 48 },
    "title": { "family": "display", "weight": 500, "size": 24, "lineHeight": 32 },
    "shelfLabel": { "family": "display", "weight": 400, "style": "italic", "size": 18, "lineHeight": 24 },
    "body": { "family": "ui", "weight": 400, "size": 15, "lineHeight": 22 },
    "label": { "family": "ui", "weight": 500, "size": 13, "lineHeight": 18 },
    "caption": { "family": "ui", "weight": 600, "size": 11, "lineHeight": 16, "tracking": "0.12em", "case": "upper" },
    "read": { "family": "read", "weight": 400, "size": 19, "lineHeight": 1.6, "min": 14, "max": 28 },
    "chapter": { "family": "display", "weight": 400, "style": "italic", "size": 30, "lineHeight": 38 },
    "ledgeTitle": { "family": "display", "weight": 500, "size": 17, "lineHeight": 22 }
  },
  "space": [4, 8, 16, 24, 32, 48, 64, 96],
  "gutter": { "phone": 16, "tablet": 24, "desktop": 40 },
  "radius": { "book": 2, "chip": 6, "control": 8, "panel": 10 },
  "size": { "touch": 44, "rail": 72, "bottomBar": 64, "clothBoard": 14, "clothBoardPhone": 7 },
  "elevation": {
    "e0": "0 0 0 1px hairline",
    "e1": "2px 2px 0 rgba(0,0,0,.22), 5px 3px 8px rgba(0,0,0,.28)",
    "e2": "3px 4px 0 rgba(0,0,0,.18), 8px 10px 16px rgba(0,0,0,.32)",
    "e3": "0 0 0 1px hairline, 6px 16px 32px rgba(0,0,0,.45)"
  },
  "motion": {
    "ease": "cubic-bezier(.25,.8,.25,1)",
    "lift": { "distance": -4, "duration": 180 },
    "open": { "total": 780, "steps": [
      { "name": "lift", "start": 0, "duration": 180 },
      { "name": "forward", "start": 120, "duration": 420 },
      { "name": "spread", "start": 400, "duration": 380, "pagesFadeDelay": 120 }
    ] },
    "close": { "total": 640, "steps": [
      { "name": "fold", "start": 0, "duration": 300 },
      { "name": "home", "start": 220, "duration": 420 }
    ] },
    "pageTurn": { "duration": 200, "slide": 24 },
    "sheet": 280,
    "reduced": { "crossfade": 200 }
  },
  "breakpoint": { "tablet": 600, "desktop": 1024 },
  "spine": {
    "widthPx": "round((widthBase + pages * widthPerPage) * scale)",
    "widthBase": 16,
    "widthPerPage": 0.034,
    "heightRange": [160, 206],
    "densityCompact": 0.85,
    "minType": 8,
    "maxTypeToWidth": 0.56,
    "baseType": { "cloth": 13, "paper": 12, "bold": 12, "band": 11, "series": 12 },
    "charWidth": { "serif": 0.56, "caps": 0.82 },
    "capsStyles": ["bold", "band"],
    "authorScale": 0.8,
    "trackingCaps": "0.06em",
    "padHead": 10,
    "padFoot": 22,
    "gap": 8,
    "padSide": 3,
    "lineHeight": 1.15,
    "headReserve": { "cloth": 16, "series": 24 },
    "bandShare": 0.2,
    "mark": { "dot": 6, "line": 2, "icon": 10, "numeral": 14 },
    "shelfGap": 2,
    "opacityDownloading": 0.72,
    "opacityOffline": 0.42,
    "saturateOffline": 0.4,
    "styles": ["cloth", "paper", "bold", "band", "series"],
    "inkLight": "#EFE6D6",
    "inkDark": "#2A2622",
    "foil": "#D9B872",
    "cloth": {
      "oxblood": "#6B2B2B", "moss": "#3E5638", "navy": "#25374F", "slate": "#3C4550", "plum": "#4D3350",
      "ochre": "#7A5418", "teal": "#21504E", "charcoal": "#2F2C29", "rust": "#83391F", "forest": "#2C4434",
      "linen": "#E4DAC5", "straw": "#DFCB98", "mist": "#C9D3D0", "blush": "#E2C4B8"
    },
    "lightCloths": ["linen", "straw", "mist", "blush"]
  },
  "bookcase": {
    "cabinetSide": 14,
    "cabinetTop": 14,
    "divider": 12,
    "columns": { "phone": [1], "tablet": [1, 1], "desktop": [1.35, 1, 1] }
  },
  "shelf": {
    "pad": 16,
    "densityCompact": 0.75,
    "labelLine": 24,
    "board": { "height": 16, "top": 3, "front": 9, "under": 4, "fill": "linear-gradient(woodTop 0 top, wood top top+front, woodUnder height-under 100%)" },
    "bookend": { "width": 5, "height": 112, "light": "linear-gradient(135deg, rgba(255,255,255,.22) 0, rgba(255,255,255,0) 60%)" },
    "slot": { "width": 32, "height": 183 },
    "bayLamp": "radial-gradient(130% 90% at 0 0, glow, transparent 70%)",
    "bayInset": { "dark": "inset 0 12px 14px -10px rgba(0,0,0,.7)", "light": "inset 0 10px 12px -10px rgba(80,55,30,.3)" }
  },
  "cover": {
    "ratio": "2 / 3",
    "heightPerWidth": 1.5,
    "shade": "linear-gradient(90deg, rgba(0,0,0,.32) 0, rgba(0,0,0,.12) 1px, transparent 2px)",
    "placeholder": "radial-gradient(120% 80% at 15% 10%, rgba(255,255,255,.20), transparent 60%), linear-gradient(transparent 45%, rgba(0,0,0,.22))",
    "placeholderBlur": 12,
    "frameInset": 4,
    "pad": 0.1,
    "mark": 0.22,
    "typeMax": 0.17,
    "minType": 8,
    "author": 0.09,
    "lineHeight": 1.15,
    "charWidth": 0.55
  },
  "progress": { "bar": 3, "track": "rgba(0,0,0,.38)" },
  "ledge": {
    "cover": { "phone": 80, "tablet": 88, "desktop": 104 },
    "metaWidth": 176,
    "gap": 24
  },
  "reading": { "pagesPerMinute": 1.3 }
}
